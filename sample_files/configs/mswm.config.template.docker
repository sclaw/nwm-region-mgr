# ------------------------------------------------
# Main Input Configuration Template File
#
# This file is used to create the input config files and realization file used to run Ngen.
# It contains three sections:
#    1. General
#    2. Regionalization
#    3. DataFile
# Variables in the sections for unused run types (i.e. calibration section for a regionalization run) are not loaded
# ------------------------------------------------

[General]

# Stream gage ID at basin outlet or VPU basin
basin = {vpu}

# Run name (options: calibration, regionalization, default)
run_type = regionalization

# User defined formulation run name (used to create folder for inputs/outputs; so no space in the name)
formulation = {run_name}

# Main directory to store input, output and other files  
main_dir = {work_dir}

# Simulation time period for Default and Regionalization Runs
# Overriden by calibration time variables when run_type is calibration
start_period = {start_time}
end_period = {end_time}

[Regionalization]
# Formulation and catchment group files generated by regionalization
form_assign_file = {par_file}
cat_grp_file = {pair_file}

[Forcing]
# Forcing provider (csv or bmi)
forcing_provider = bmi

# Forcing engine template file directory
forcing_template_dir = /ngen-app/ngen-forcing/NextGen_Forcings_Engine_BMI/BMI_NextGen_Configs/config_templates/

# Forcing engine root directory (used to specify root location of forecast files)
root_dir = /ngen-app/data

# Forcing engine configurations
forcing_configuration = aorc


[DataFile]
# Path to hydrofabric data (geopackage)  
hydrofab_file = {gpkg_file}

# Directory or file for constant/additional module parameters (currently applicable to noah, lasam, ueb, sac-sma, and snow-17)
# these can be found in the nwm-cal-mgr source repo under nwm-cal-mgr/module_parameter_files
# SAC parameter file can be found at: s3://ngwpc-hydrofabric/sac_sma_params_2.2.csv
# snow-17 parameter file can be found at: s3://ngwpc-hydrofabric/snow17_params_2.2.csv
noah_parameter_dir = /home/yuqiong.liu/repos/nwm-cal-mgr/module_parameter_files/noah-owp-modular
ueb_parameter_dir = /home/yuqiong.liu/repos/nwm-cal-mgr/module_parameter_files/ueb
lasam_parameter_dir = /home/yuqiong.liu/repos/nwm-cal-mgr/module_parameter_files/lasam
lstm_parameter_dir = /home/yuqiong.liu/repos/nwm-cal-mgr/module_parameter_files/lstm
sac_parameter_dir = /home/yuqiong.liu/data/hydrofabric
snow_17_parameter_dir = /home/yuqiong.liu/data/hydrofabric

# Executable file for running ngen BMI
ngen_exe_file = /ngen-app/ngen/cmake_build/ngen

# Library files for modules (can be left blank if module is not selected)
sloth_lib = /ngen-app/ngen/extern/sloth/cmake_build/libslothmodel.so
cfe_lib = /ngen-app/ngen/extern/cfe/cmake_build/libcfebmi.so
lasam_lib = /ngen-app/ngen/extern/LASAM/cmake_build/liblasambmi.so
noah_owp_modular_lib = /ngen-app/ngen/extern/noah-owp-modular/cmake_build/libsurfacebmi.so
pet_lib = /ngen-app/ngen/extern/evapotranspiration/evapotranspiration/cmake_build/libpetbmi.so
sac_sma_lib = /ngen-app/ngen/extern/sac-sma/cmake_build/libsacbmi.so
sft_lib = /ngen-app/ngen/extern/SoilFreezeThaw/cmake_build/libsftbmi.so
smp_lib = /ngen-app/ngen/extern/SoilMoistureProfiles/cmake_build/libsmpbmi.so
snow_17_lib = /ngen-app/ngen/extern/snow17/cmake_build/libsnow17bmi.so
topmodel_lib = /ngen-app/ngen/extern/topmodel/cmake_build/libtopmodelbmi.so
ueb_lib = /ngen-app/ngen/extern/ueb-bmi/cmake_build/src/libbmiuebcxx.so


[Parallel]
parallel_ngen_exe = /ngen-app/ngen/cmake_build/ngen
partition_generator_exe = /ngen-app/ngen/cmake_build/partitionGenerator
nprocs = {nprocs}
